// Used only by the e2e suite's own build (BYWAY_NEXT_DIST_DIR=.next-e2e, see next.config.ts), so that build never
// edits tsconfig.json. It lists exactly the type folders Next.js expects for that build folder.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "plugins": [{ "name": "next" }]
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "proxy.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next-e2e/types/**/*.ts",
    ".next-e2e/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next"]
}
