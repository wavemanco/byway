{
  "name": "byway",
  "private": true,
  "type": "module",
  "description": "Research harness and engine for the Off-Center protocol",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p scripts/tsconfig.json && pnpm -r --if-present run typecheck",
    "start": "tsx scripts/serve.ts start",
    "demo": "tsx scripts/serve.ts start --demo",
    "dev": "tsx scripts/serve.ts dev",
    "e2e": "tsx scripts/e2e.ts",
    "recipes:emit": "tsx packages/catalog/src/emit.ts",
    "byway": "tsx packages/cli/src/main.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "zod": "^4.6.5"
  }
}
