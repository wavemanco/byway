export const set = (i: number, t: string) => (o: string[]) => o.map((l, k) => (k === i ? t : l));
export const find = (re: RegExp, t: string | ((l: string) => string)) => (o: string[]) => {
  const k = o.findIndex((l) => re.test(l));
  if (k < 0) return o;
  return o.map((l, j) => (j === k ? (typeof t === 'string' ? t : t(l)) : l));
};
